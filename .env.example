
# SUPABASE: Database, Auth, Realtime, Storage (MANDATORY)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# APP_URL: Public base URL of this deployment. Invitation links are built from
# it, so it must be the address members can actually reach (not localhost in
# production) or invite links will point at the wrong host.
APP_URL="http://localhost:3000"

# LIVEKIT: Sam_Teck Meet Virtual Meeting WebRTC Service (MANDATORY for Sam_Teck Meet)
# LIVEKIT_URL is the LiveKit Cloud project URL, e.g. wss://<project>.livekit.cloud.
#   It is returned to the browser as the WebRTC websocket endpoint, so it is NOT secret.
# LIVEKIT_API_KEY identifies your LiveKit project for token minting. It is also not secret.
# LIVEKIT_API_SECRET signs the access tokens. SERVER-SIDE ONLY — set it in the Vercel
#   project Environment Variables and never prefix it with VITE_ or NEXT_PUBLIC_, or it
#   will be inlined into the public client bundle and anyone could mint admin tokens.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# FIRST-RUN SETUP: Secret token to authorize initial administrator provisioning
SETUP_PROVISIONING_SECRET=""
