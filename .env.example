
# SUPABASE: Database, Auth, Realtime, Storage (MANDATORY)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# APP_URL: Public base URL of this deployment. Invitation links are built from
# it, so it must be the address members can actually reach (not localhost in
# production) or invite links will point at the wrong host.
APP_URL="http://localhost:3000"

# GOOGLE MEET: meeting spaces are created server-side by the Google Meet REST API.
#
#   SERVER-SIDE ONLY. Do NOT prefix any of these with VITE_ or NEXT_PUBLIC_ —
#   Vite inlines VITE_* values into the public browser bundle, which would
#   publish your OAuth credentials to every visitor. The browser never needs
#   them: it only ever receives the finished https://meet.google.com/ link.
#
#   An API key does NOT work here. The Meet REST API answers every API-key
#   request with 401 UNAUTHENTICATED, "API keys are not supported by this API.
#   Expected OAuth2 access token or other authentication credentials that
#   assert a principal." You need OAuth 2.0 user credentials.
#
#   How to obtain them (Google Cloud console):
#     1. Create (or pick) a Google Cloud project and ENABLE the "Google Meet
#        API" for it.
#     2. Configure the OAuth consent screen, add yourself as a test user (or
#        publish the app), and add the scope `meetings.space.created`.
#        Note: `meetings.space.created` is a SENSITIVE scope and requires
#        verification; until the app is verified, only added test users can
#        authorise it.
#     3. Create an OAuth 2.0 Client ID of type "Desktop app".
#        -> RECOMMENDED. Desktop clients accept the `http://localhost` loopback
#           redirect automatically, so nothing has to be registered by hand.
#        -> If you already made the client as type "Web application" instead,
#           you MUST add this exact URI to its "Authorised redirect URIs":
#               http://localhost:53682
#           Google validates the redirect URI BEFORE redirecting, so if it is
#           missing the consent screen renders "Error 400: redirect_uri_mismatch"
#           and never calls back — the flow hangs with no other clue.
#     4. Put the id and secret into the two variables below, then run:
#            pnpm google-meet:oauth
#        That helper runs the whole flow locally, prints the refresh token to
#        the terminal only, and fails fast with these exact instructions if the
#        redirect URI is not registered. Paste the result into
#        GOOGLE_MEET_REFRESH_TOKEN and restart the dev server.
#
#   GOOGLE_MEET_CLIENT_ID     - the OAuth client id (public-ish identifier, but
#                               kept server-side so the app stays least-privilege).
#   GOOGLE_MEET_CLIENT_SECRET - the OAuth client secret. SERVER-SIDE ONLY.
#   GOOGLE_MEET_REFRESH_TOKEN - the long-lived grant that lets the server mint
#                               short-lived access tokens. SERVER-SIDE ONLY.
#
#   If these are left unset the rest of Sam_Teck Hub works unchanged; meetings
#   simply report "Google Meet is not connected to this deployment yet"
#   instead of creating a link. Nothing is faked and no placeholder link is
#   ever stored.
GOOGLE_MEET_CLIENT_ID=""
GOOGLE_MEET_CLIENT_SECRET=""
GOOGLE_MEET_REFRESH_TOKEN=""

# FIRST-RUN SETUP: Secret token to authorize initial administrator provisioning
SETUP_PROVISIONING_SECRET=""
